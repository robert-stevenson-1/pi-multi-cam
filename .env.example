# Copy to .env on each Pi and edit per device. .env is gitignored.
# On the primary: PRIMARY_HOST must reach its own cam_server (127.0.0.1 or its IP).
# On secondaries: PRIMARY_HOST = primary's IP.
MODE=p
# Use pi0 on the primary and a unique ID such as pi1 on each secondary.
PI_ID=pi0
PRIMARY_HOST=127.0.0.1
PRIMARY_PORT=8080
SECONDARY_PORT=8081
AF_MODE=continuous
GPIO_TRIGGER_PIN=19
MAX_SECONDARIES=3
CAPTURES_DIR=captures
# web_gallery.py
PORT=8088
# cam_preview.py only
PREVIEW_PORT=9090
SIZE=640x480
